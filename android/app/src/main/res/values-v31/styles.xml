<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) uses the SplashScreen API which overrides launch_background.xml.
    This file forces a pure-black splash with no icon so no Flutter logo is shown.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="android:windowSplashScreenBrandingImage">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
